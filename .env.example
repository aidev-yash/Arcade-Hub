# API server port
PORT=8080

# Discord bot — required to run the discord-bot package
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id-here
# Optional: set to deploy commands to a specific guild instantly instead of globally
DISCORD_GUILD_ID=

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Node environment (development, production)
NODE_ENV=development

# Base path for frontend apps (e.g. "/" for root, "/app" for sub-path)
BASE_PATH=/
